# ---- MySQL ----
# On Railway: set this to ${{MySQL.MYSQL_URL}} (the service must be named "MySQL").
# Elsewhere:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://bestie:change-me@localhost:3306/bestie_surprise
# Keep false on Railway's private network. Set true if your host requires TLS.
DB_SSL=false
# Optional: provider CA certificate (PEM text; use \n for line breaks).
# DB_SSL_CA=

# ---- Friend's password to open the surprise ----
SITE_PASSWORD=the-password-your-friend-will-type

# ---- Your admin password (used only at /admin) ----
ADMIN_PASSWORD=a-different-strong-password-only-you-know

# ---- Random secret, 32+ chars (openssl rand -hex 32). Signs both cookies. ----
SITE_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-chars
