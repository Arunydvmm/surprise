# ---- MySQL ----
# On Railway: set this to ${{MySQL.MYSQL_URL}} (the service must be named "MySQL").
# Elsewhere:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://surprise4u:change-me@localhost:3306/surprise4u
# Keep false on Railway's private network. Set true if your host requires TLS.
DB_SSL=false
# Optional: provider CA certificate (PEM text; use \n for line breaks).
# DB_SSL_CA=
# Optional MySQL connection pool size (1-20; default 5).
DB_POOL_SIZE=5

# ---- Public address of the site (no trailing slash) ----
# Used to build the Google sign-in redirect URL: APP_URL/api/auth/google/callback
APP_URL=http://localhost:3000

# ---- Google sign-in (see README, "Set up Google sign-in") ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Admins: comma-separated Google emails. These accounts are admins automatically. ----
ADMIN_EMAILS=you@gmail.com

# ---- Random secret, 32+ chars (openssl rand -hex 32). Signs the short-lived cookies. ----
SITE_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-chars

# ---- Only needed ONCE when upgrading an existing Bestie Surprise database ----
# Your friend's old password. It becomes the password of the original surprise (stored hashed).
# You can remove this variable after the first successful start.
# SITE_PASSWORD=the-old-password

# ---- Optional ----
# How many reverse proxies sit in front of the app (Railway = 1, Cloudflare + Railway = 2).
TRUSTED_PROXY_HOPS=1
# Shown on the Privacy / Terms pages and in the footer (can also be set in Admin > Settings).
# CONTACT_EMAIL=hello@example.com
