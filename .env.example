# ---- MySQL (any MySQL 8 / MariaDB 10.5+ server) ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE   (URL-encode special characters in the password)
DATABASE_URL=mysql://bestie:change-me@localhost:3306/bestie_surprise
# Set to true if your provider requires TLS (most hosted MySQL services do).
DB_SSL=false
# Optional: provider CA certificate (PEM text; use \n for line breaks) when the provider uses its own CA.
# DB_SSL_CA=
# Last resort only: skip certificate verification.
# DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Friend's password to open the surprise ----
SITE_PASSWORD=the-password-your-friend-will-type

# ---- Your admin password (used only at /admin) ----
ADMIN_PASSWORD=a-different-strong-password-only-you-know

# ---- Random secret, 32+ chars (openssl rand -hex 32). Signs both cookies. ----
SITE_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-chars
